game.Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		character.Humanoid.Seated:Connect(function(active, seatPart)
			if seatPart == nil then player.Character:ScaleTo(1) return end
			if seatPart.Name ~= "Lambo" then return end
			seatPart:SetNetworkOwner(player)
			print("Owner", player.Name)
			player.Character:ScaleTo(0.5)
		end)
	end)
end)
